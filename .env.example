# =========================================================================
# .env.example — copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local ne doit JAMAIS être commité (déjà exclu par .gitignore).
# Sur Vercel : Project Settings → Environment Variables (ne pas les mettre
# dans le code, ni dans un fichier commité, ni partagées par chat/email en clair).
# =========================================================================

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                # clé publique, protégée par la RLS
SUPABASE_SERVICE_ROLE_KEY=eyJ...                    # clé secrète, SERVEUR UNIQUEMENT, contourne la RLS

# --- Paiement ----------------------------------------------------------------
# 'manuel' tant que le compte marchand KKiaPay n'est pas encore créé.
# Passez à 'kkiapay' dès que vous avez vos clés ci-dessous (déblocage automatique).
PAYMENT_MODE=manuel

# Prix du rapport complet (FCFA). Seule source de vérité pour le montant facturé :
# le client ne peut jamais l'imposer lui-même (voir app/api/payment/initiate/route.js).
PRIX_RAPPORT_FCFA=325

# Numéros de réception (configurés aussi comme comptes de reversement dans
# le tableau de bord KKiaPay une fois le compte créé) :
MERCHANT_MOMO_NUMBER=0153731434
MERCHANT_MOOV_NUMBER=0143599669

# À remplir une fois votre compte KKiaPay créé sur https://kkiapay.me :
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true                                # passez à false en production réelle

# --- Espace admin ------------------------------------------------------------
# Générez ce hash UNE FOIS en local, ne mettez jamais le mot de passe en clair ici :
#   node -e "console.log(require('bcryptjs').hashSync('Réussite2.0', 12))"
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=                                   # chaîne aléatoire longue, ex: `openssl rand -base64 48`
